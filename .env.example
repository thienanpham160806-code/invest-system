
# ----- DNSE OpenAPI (https://developers.dnse.com.vn) -----
DNSE_API_KEY=
DNSE_API_SECRET=
DNSE_BASE_URL=https://openapi.dnse.com.vn
DNSE_API_VERSION=2026-05-07

# ----- Vietcap / VCI (truy cap qua thu vien vnstock) -----
# Chay register_user() cua vnstock mot lan roi dat bien nay bang 1
VNSTOCK_ACCEPT_TOS=0

# Chat id tu dang ky ban tin tin tuc (/tintuc on) moi lan bot khoi dong (cach
# nhau dau phay, id nhom la so am). Can tren Render Free: CSDL bi xoa moi lan
# restart. /tintuc on in ra chat id cua ban.
AUTO_SUBSCRIBE_CHAT_IDS=

# ----- Duong dan luu tru -----
DATA_DIR=./data
CACHE_DB=./data/cache.sqlite3
MODEL_DIR=./artifacts
LOG_LEVEL=INFO

# ----- Gioi han quy mo (tuy chon, ghi de config/settings.yaml) -----
# De trong = dung gia tri trong settings.yaml. Huu ich tren may chu nho
# (vd Render goi Free 512 MB) ma khong phai sua file cau hinh trong repo.
# So ma thanh khoan nhat duoc tinh snapshot (0 = khong gioi han). Goi y Render Free: 400
UNIVERSE_MAX_SYMBOLS=
# So phien tai cho moi ma khi nap kho lan dau (mac dinh 500 ~ 2 nam)
MARKET_COUNT_BACK=
# So luong tinh snapshot (mac dinh 1 = tuan tu, it RAM nhat)
SNAPSHOT_MAX_WORKERS=

# ----- (Tuỳ chọn) Nhận định bằng một provider: openai hoặc gemini -----
OPENAI_API_KEY=
GEMINI_API_KEY=
LLM_ENABLED=0
LLM_PROVIDER=openai
OPENAI_MODEL=gpt-6-luna
GEMINI_MODEL=gemini-3.5-flash-lite
